<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- 植物园页面（F2），由 MainController 导航加载；外层 ScrollPane 兜底防止内容超出被裁 -->
<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="csu.mengya.controller.GardenController"
            fitToWidth="true"
            styleClass="page-scroll">

    <VBox spacing="12" styleClass="page">
        <Label text="植物园" styleClass="page-title"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="模拟完成专注（+25 能量）" onAction="#onSimulateFocus"/>
            <Button text="长到下一阶段" onAction="#onGrowStage"/>
            <Button text="收获成熟作物" onAction="#onHarvest"/>
            <Button text="重置植物园" onAction="#onReset"/>
            <Label fx:id="totalEnergyLabel" styleClass="status"/>
        </HBox>

        <HBox spacing="16" alignment="TOP_LEFT">
            <VBox spacing="8">
                <Label text="作物图鉴" styleClass="section-title"/>
                <Label text="点击选中 · 拖拽到空地种植 · 未解锁灰暗" styleClass="section-subtitle"/>
                <ScrollPane fitToWidth="true" styleClass="page-scroll" prefWidth="216" prefHeight="330">
                    <FlowPane fx:id="collectionPane" hgap="8" vgap="8" prefWrapLength="206"/>
                </ScrollPane>
                <Button text="解锁选中作物" onAction="#onUnlock" maxWidth="Infinity"/>
                <Button text="种植选中作物" onAction="#onPlant" maxWidth="Infinity"/>
            </VBox>
            <FlowPane fx:id="plotPane" hgap="12" vgap="12" prefWrapLength="520"/>
        </HBox>

        <Label fx:id="statusLabel" styleClass="status"/>
    </VBox>
</ScrollPane>
