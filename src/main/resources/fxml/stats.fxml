<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- 数据统计页面（F5），图表由 StatsController 动态构建 -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="csu.mengya.controller.StatsController"
      spacing="12"
      styleClass="page">

    <Label text="数据统计" styleClass="page-title"/>
    <Label fx:id="summaryLabel" styleClass="status"/>
    <VBox fx:id="chartContainer" spacing="16"/>
</VBox>
