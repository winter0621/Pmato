<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  主框架：左侧边栏（F1-F6 导航）+ 中央内容区。
  F2/F5 已接入真实页面，F3/F4 由 A/C 接入，F1/F6 暂为占位。
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="csu.mengya.controller.MainController"
            prefWidth="1100" prefHeight="700" styleClass="app-shell">

    <left>
        <VBox prefWidth="230" spacing="10" styleClass="sidebar">
            <padding>
                <Insets top="28" right="18" bottom="24" left="18"/>
            </padding>
            <Label text="pmato" styleClass="brand-title"/>
            <Label text="植物园式学习计时" styleClass="brand-subtitle"/>

            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Button text="F1  专注学习" onAction="#showFocus" styleClass="nav-button"/>
                <Button text="F2  植物园" onAction="#showGarden" styleClass="nav-button"/>
                <Button text="F3  待办清单" onAction="#showTodo" styleClass="nav-button"/>
                <Button text="F4  日程规划" onAction="#showSchedule" styleClass="nav-button"/>
                <Button text="F5  数据统计" onAction="#showStats" styleClass="nav-button"/>
                <Button text="F6  系统与设置" onAction="#showSettings" styleClass="nav-button"/>
            </VBox>

            <Label fx:id="statusLabel" text="系统就绪" styleClass="sidebar-status" wrapText="true"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content">
            <padding>
                <Insets top="30" right="36" bottom="30" left="36"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="contentTitle" text="F2  植物园养成" styleClass="page-title"/>
                    <Label fx:id="contentDescription" text="学习时长转化为能量，培育并收获作物" styleClass="page-description"/>
                </VBox>
                <Label text="今日专注  0 分钟" styleClass="summary-pill"/>
            </HBox>
            <StackPane fx:id="contentHost" VBox.vgrow="ALWAYS" styleClass="page-card"/>
        </VBox>
    </center>
</BorderPane>
