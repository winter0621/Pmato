<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  主框架：左侧边栏（F1-F6 导航）+ 中央内容区。
  F2/F5 已接入真实页面，F3/F4 由 A/C 接入，F1/F6 暂为占位。
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="csu.mengya.controller.MainController"
            prefWidth="1280" prefHeight="800" styleClass="app-shell">

    <left>
        <VBox prefWidth="232" spacing="10" styleClass="sidebar">
            <padding>
                <Insets top="30" right="16" bottom="24" left="16"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="brand-lockup">
                <Label text="P" styleClass="brand-mark"/>
                <VBox spacing="2"><Label text="Pmato" styleClass="brand-title"/><Label text="把专注种成花园" styleClass="brand-subtitle"/></VBox>
            </HBox>

            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Label text="学习空间" styleClass="nav-section-label"/>
                <Button text="专注计时" onAction="#showFocus" styleClass="nav-button"/>
                <Button text="我的花园" onAction="#showGarden" styleClass="nav-button"/>
                <Button text="待办事项" onAction="#showTodo" styleClass="nav-button"/>
                <Button text="学习日历" onAction="#showSchedule" styleClass="nav-button"/>
                <Button text="成长记录" onAction="#showStats" styleClass="nav-button"/>
                <Label text="偏好设置" styleClass="nav-section-label"/>
                <Button text="设置" onAction="#showSettings" styleClass="nav-button"/>
                <Button text="学习建议" onAction="#showAssistant" styleClass="nav-button nav-button-quiet"/>
            </VBox>

            <Label fx:id="statusLabel" text="系统就绪" styleClass="sidebar-status" wrapText="true"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content">
            <padding>
                <Insets top="24" right="28" bottom="24" left="28"/>
            </padding>
            <HBox alignment="CENTER_LEFT" styleClass="topbar">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="contentTitle" text="我的花园" styleClass="page-title"/>
                    <Label fx:id="contentDescription" text="学习时长转化为能量，培育并收获作物" styleClass="page-description"/>
                </VBox>
                <Label fx:id="todayFocusLabel" text="今日专注  0 分钟" styleClass="summary-pill"/>
            </HBox>
            <StackPane fx:id="contentHost" VBox.vgrow="ALWAYS" styleClass="page-card"/>
        </VBox>
    </center>
</BorderPane>
