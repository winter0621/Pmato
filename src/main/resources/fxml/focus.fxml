<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="csu.mengya.controller.FocusController" spacing="16" styleClass="focus-page">
    <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
    <Label text="专注学习" styleClass="section-title"/>
    <Label text="选一个待办，开始专注；完成后自动进入短休或长休" styleClass="section-subtitle"/>
    <HBox spacing="10" styleClass="form-row">
        <Label text="关联待办"/>
        <ComboBox fx:id="todoBox" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Label text="专注分钟"/>
        <Spinner fx:id="minutesSpinner" prefWidth="95"/>
    </HBox>
    <VBox spacing="12" alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="focus-clock-card">
        <Label fx:id="modeLabel" text="专注学习" styleClass="focus-mode"/>
        <Label fx:id="timerLabel" text="25:00" styleClass="focus-time"/>
        <Label fx:id="cycleLabel" text="已完成 0 个番茄" styleClass="focus-cycle"/>
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="startButton" text="开始专注" onAction="#startFocus" styleClass="primary-button"/>
            <Button fx:id="pauseButton" text="暂停" onAction="#pauseFocus" styleClass="secondary-button"/>
            <Button fx:id="resumeButton" text="继续" onAction="#resumeFocus" styleClass="secondary-button"/>
            <Button fx:id="abandonButton" text="放弃" onAction="#abandonFocus" styleClass="secondary-button"/>
            <Button fx:id="skipButton" text="跳过休息" onAction="#skipBreak" styleClass="secondary-button"/>
        </HBox>
    </VBox>
    <Label fx:id="focusStatus" text="选择任务并开始专注" styleClass="page-feedback" wrapText="true"/>
</VBox>